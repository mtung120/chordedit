# Copy to deploy.env (gitignored) and fill in. Read by deploy.sh and server.sh.
# ssh destination for the deploy user: an ~/.ssh/config alias or user@host.
CHORDEDIT_HOST=deploy@chords.example.com
# ssh destination with sudo, used only by ./server.sh provision (defaults to CHORDEDIT_HOST).
#CHORDEDIT_ADMIN_HOST=admin@chords.example.com
CHORDEDIT_DOMAIN=chords.example.com
