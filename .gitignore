# Song data. Production keeps it in SONGS_DIR (/var/data/chordedit/songs
# with deploy/setup-server.sh); the repo-root songs/ is local dev data and
# never belongs in git. (Anchored: tests/fixtures/songs/ is tracked.)
/songs/

# Node / Playwright / Vite — baseline screenshots in tests/visual/ are
# committed, build artefacts aren't. static/dist/ is regenerated by
# `npm run build` (deploy.sh runs it).
node_modules/
.venv/
test-results/
playwright-report/
playwright/.cache/
.playwright-mcp/
static/dist/
tsconfig.tsbuildinfo

# Local backups (deploy.sh --backup, download-songs.sh). They can hold
# secrets (YouTube cookies).
backups/
downloaded_songs/

# Local secrets and scratch. .env holds dev secrets (YOUTUBE_API_KEY),
# read by handlers/dotenv.go.
.env
.DS_Store
.mcp.json
.claude/
*.mp3
# Your server's settings for deploy.sh / server.sh (see deploy.env.example).
deploy.env
