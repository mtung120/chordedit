# /etc/chordedit/env — read by chordedit.service.
# Owner root:chordedit, mode 0640. Never commit the real file.
PORT=8080
SONGS_DIR=/var/data/chordedit/songs
# Venv with yt-dlp + Demucs (deploy/requirements.txt).
CHORDEDIT_PYTHON=/opt/chordedit/venv/bin/python
# Demucs model weights, downloaded by setup-server.sh (the service can't write here).
TORCH_HOME=/opt/chordedit/models
YOUTUBE_API_KEY=
